# Copy to `.env` and fill in real values. `.env` is gitignored.

DATABASE_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL_DIRECT="postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Optional -----------------------------------------------------------------

# Minimum gap between two requests to the SAME host, in ms (default 2500).
# Enforced for every request the crawler makes, across all stages. Different
# hosts are unaffected, so raising concurrency is how you go faster — not
# lowering this.
# MIN_HOST_INTERVAL_MS=2500

# Route all outbound requests through a proxy (e.g. a rotating residential
# pool). Leave unset for direct connections. Format:
#   http://USERNAME:PASSWORD@HOST:PORT
# Put the real value in .env only — never commit it or paste it into chat.
# PROXY_URL=

# How many DIFFERENT domains are worked on at once (defaults: 5 for crawling,
# 8 for contact lookup). Each site is still only hit once per MIN_HOST_INTERVAL_MS,
# so raising these is the safe way to get more done per hour. Each in-flight
# crawl parses pages in memory, so raise gradually and watch RAM (10-15 is
# reasonable on a 1 GB+ server).
# CRAWL_CONCURRENCY=5
# CONTACT_CONCURRENCY=8

# How often the worker daemon (`npm run worker`) checks for queued campaigns, in ms (default 5000).
# POLL_INTERVAL_MS=5000

# Automatic escalation for a domain the plain HTTP client found "blocked"
# (src/rescueFetchers.ts): tries a real browser, then CapSolver if that's
# still not enough. A different proxy variable from PROXY_URL above on
# purpose — this one is only spent on already-blocked domains, not every
# request. Needs real memory headroom to run (Chromium: ~300-500MB).
# CAPSOLVER_API_KEY=
# RESCUE_PROXY_URL=
# Concurrent browser pages for blocked domains (default 2). Raise if many domains are blocked and contact lookups are slow.
# BROWSER_CONCURRENCY=2
