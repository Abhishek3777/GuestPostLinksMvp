# Dashboard image (Next.js). Build context = the repo root.
#
#   docker build -f deploy/Dockerfile.dashboard \
#     --build-arg NEXT_PUBLIC_SUPABASE_URL=... --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=... \
#     -t gpl-dashboard .
FROM node:22-slim AS build
WORKDIR /app

COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci

COPY dashboard/ ./

# NEXT_PUBLIC_* values are baked into the browser bundle at BUILD time, so they
# must be present here — setting them only at runtime is too late. (The anon key
# is public by design; the database URL is NOT needed to build.)
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Whole node_modules (not --omit=dev): next.config.ts is loaded at start-up and
# the app is small enough that image size is not worth the risk.
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/next.config.ts ./
COPY --from=build /app/public public
COPY --from=build /app/.next .next

# Railway sets PORT; bind to all interfaces so the platform can reach it.
CMD ["sh", "-c", "exec node_modules/.bin/next start -H 0.0.0.0 -p ${PORT:-3000}"]
